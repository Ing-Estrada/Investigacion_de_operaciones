# ===========================================================================
# Route Optimizer — variables de entorno para docker-compose
# Copiar a `.env` y reemplazar TODOS los valores marcados como CHANGE_ME.
# Este archivo SI se versiona; `.env` NUNCA (ver .gitignore, RNF-004).
# ===========================================================================

# ---------------------------------------------------------------------------
# PostgreSQL + PostGIS
# ---------------------------------------------------------------------------
POSTGRES_USER=routeopt
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_DB=route_optimizer
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Redis (caché distribuido + rate limiting)
# ---------------------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME_redis_password
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
NODE_ENV=development
BACKEND_PORT=3001

# Generar con: openssl rand -base64 48   (mínimo 32 caracteres, distintos entre sí)
JWT_ACCESS_SECRET=CHANGE_ME_access_secret_min_32_chars_long_value
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret_min_32_chars_different
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

COOKIE_DOMAIN=localhost
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Proveedores de red vial y geocodificación (open source por defecto)
# ---------------------------------------------------------------------------
ROUTING_PROVIDER=osrm
OSRM_BASE_URL=http://router.project-osrm.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# Nominatim exige un User-Agent identificable con contacto real.
NOMINATIM_USER_AGENT=route-optimizer/1.0 (contacto@example.com)

# Opcional: solo si ROUTING_PROVIDER=google
GOOGLE_MAPS_API_KEY=

# ---------------------------------------------------------------------------
# Clima
# ---------------------------------------------------------------------------
WEATHER_PROVIDER=openweather
OPENWEATHER_API_KEY=
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5

# ---------------------------------------------------------------------------
# Modelo de costos
# ---------------------------------------------------------------------------
DEFAULT_FUEL_PRICE_PER_LITER=1.05
DEFAULT_CURRENCY=USD

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
