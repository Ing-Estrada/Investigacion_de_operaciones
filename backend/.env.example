# ===========================================================================
# Backend — copiar a `.env` y rellenar. NUNCA versionar el `.env`.
# ===========================================================================

NODE_ENV=development
PORT=3001
API_PREFIX=api/v1

# --- PostgreSQL + PostGIS ---------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=routeopt
DB_PASSWORD=CHANGE_ME
DB_NAME=route_optimizer
DB_SSL=false
DB_POOL_SIZE=20

# --- Redis ------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- JWT --------------------------------------------------------------------
# Generar cada uno por separado: openssl rand -base64 48
# Deben ser distintos entre sí y tener 32+ caracteres, o el arranque falla.
JWT_ACCESS_SECRET=CHANGE_ME_access_secret_of_at_least_32_characters
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret_of_at_least_32_chars_diff
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

COOKIE_DOMAIN=localhost
CORS_ORIGINS=http://localhost:3000

RATE_LIMIT_DEFAULT_MAX=100
RATE_LIMIT_DEFAULT_WINDOW_SEC=60

# --- Red vial y geocodificación --------------------------------------------
ROUTING_PROVIDER=osrm
OSRM_BASE_URL=http://router.project-osrm.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# La política de Nominatim exige un contacto real en el User-Agent.
NOMINATIM_USER_AGENT=route-optimizer/1.0 (tu-correo@example.com)
GOOGLE_MAPS_API_KEY=

# --- Clima ------------------------------------------------------------------
# Sin clave, el sistema usa el proveedor nulo y calcula rutas sin ajuste meteorológico.
WEATHER_PROVIDER=openweather
OPENWEATHER_API_KEY=
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5

EXTERNAL_API_TIMEOUT_MS=8000

# --- Modelo de costes -------------------------------------------------------
DEFAULT_FUEL_PRICE_PER_LITER=1.05
DEFAULT_CURRENCY=USD

# --- Seed (solo para `npm run seed`) ---------------------------------------
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
